FROM almalinux:9

ARG SSH_USER=dev
ARG SSH_PASSWORD=changeme
ARG DOTNET_VERSION=10.0
ARG NODE_MAJOR=24


RUN dnf install -y --allowerasing openssh-server curl tar gzip unzip procps-ng libicu bash epel-release && \
    dnf install -y neovim git ripgrep fd-find gcc make && \
    dnf clean all

# Neovim officiel en surcouche (LazyVim exige >= 0.9, le paquet distro est trop ancien)
ARG NVIM_VERSION=v0.12.6
RUN curl -sSL https://github.com/neovim/neovim/releases/download/${NVIM_VERSION}/nvim-linux-x86_64.tar.gz | tar -xz -C /opt && \
    ln -sf /opt/nvim-linux-x86_64/bin/nvim /usr/local/bin/nvim

# Bash comme shell par défaut
SHELL ["/bin/bash", "-c"]
ENV SHELL=/bin/bash

# Yazi (file manager console)
ARG YAZI_VERSION=v26.9.1
RUN curl -sSL https://github.com/sxyazi/yazi/releases/download/${YAZI_VERSION}/yazi-x86_64-unknown-linux-musl.zip -o /tmp/yazi.zip && \
    unzip -q /tmp/yazi.zip -d /tmp/yazi && \
    install -m 755 /tmp/yazi/yazi-x86_64-unknown-linux-musl/yazi /usr/local/bin/yazi && \
    install -m 755 /tmp/yazi/yazi-x86_64-unknown-linux-musl/ya /usr/local/bin/ya && \
    rm -rf /tmp/yazi /tmp/yazi.zip

RUN ssh-keygen -A

RUN useradd -m -s /bin/bash ${SSH_USER} && \
    echo "${SSH_USER}:${SSH_PASSWORD}" | chpasswd && \
    mkdir -p /home/${SSH_USER}/.ssh && \
    chmod 700 /home/${SSH_USER}/.ssh && \
    chown -R ${SSH_USER}:${SSH_USER} /home/${SSH_USER}/.ssh

# LazyVim (surcouche de Neovim) pour ${SSH_USER}
RUN su - ${SSH_USER} -c "git clone --depth 1 https://github.com/LazyVim/starter ~/.config/nvim && rm -rf ~/.config/nvim/.git" && \
    chown -R ${SSH_USER}:${SSH_USER} /home/${SSH_USER}/.config
RUN su - ${SSH_USER} -c "nvim --headless '+Lazy! restore' +qa"

# .NET SDK (installateur officiel)
RUN curl -sSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh && \
    bash /tmp/dotnet-install.sh --channel ${DOTNET_VERSION} --install-dir /usr/share/dotnet && \
    rm /tmp/dotnet-install.sh && \
    ln -s /usr/share/dotnet/dotnet /usr/local/bin/dotnet
ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH="/usr/share/dotnet:${PATH}"
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1

# Node.js LTS (NodeSource)
RUN curl -fsSL https://rpm.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    dnf install -y nodejs && \
    dnf clean all

COPY alma-dotnet-node/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22
ENTRYPOINT ["/entrypoint.sh"]
