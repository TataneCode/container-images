FROM debian:bookworm

ARG SSH_USER=dev
ARG SSH_PASSWORD=changeme

RUN apt-get update && \
    apt-get install -y --no-install-recommends openssh-server curl gcc g++ make tar unzip procps ca-certificates neovim && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-c"]

ENV SHELL=/bin/bash

# Yazi (file manager console)
ARG YAZI_VERSION=v26.9.1
RUN curl -sSL https://github.com/sxyazi/yazi/releases/download/${YAZI_VERSION}/yazi-x86_64-unknown-linux-musl.zip -o /tmp/yazi.zip && \
    unzip -q /tmp/yazi.zip -d /tmp/yazi && \
    install -m 755 /tmp/yazi/yazi-x86_64-unknown-linux-musl/yazi /usr/local/bin/yazi && \
    install -m 755 /tmp/yazi/yazi-x86_64-unknown-linux-musl/ya /usr/local/bin/ya && \
    rm -rf /tmp/yazi /tmp/yazi.zip

RUN mkdir -p /run/sshd && ssh-keygen -A

RUN useradd -m -s /bin/bash ${SSH_USER} && \
    echo "${SSH_USER}:${SSH_PASSWORD}" | chpasswd && \
    mkdir -p /home/${SSH_USER}/.ssh && \
    chmod 700 /home/${SSH_USER}/.ssh && \
    chown -R ${SSH_USER}:${SSH_USER} /home/${SSH_USER}/.ssh

# Rustup + toolchain stable
RUN su - ${SSH_USER} -c "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile default"

ENV PATH="/home/${SSH_USER}/.cargo/bin:${PATH}"

RUN su - ${SSH_USER} -c "/home/${SSH_USER}/.cargo/bin/rustup component add rustfmt clippy"

COPY debian-rust/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22

ENTRYPOINT ["/entrypoint.sh"]
